{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/remix"],
  "files": {
    // typeset.css is vendored from shadcn/typeset, kept byte-for-byte.
    "includes": ["**", "!worker-configuration.d.ts", "!src/styles/typeset.css"]
  },
  "overrides": [
    {
      // StyleX's compiler only recognises styles reached through a namespace
      // import; `import { create }` is not transformed. The tree-shaking the
      // rule protects does not apply, since the calls compile away entirely.
      // Components and tokens, not routes: if a route needs raw StyleX, that is
      // a missing primitive rather than a reason to widen this.
      "includes": ["src/components/**", "src/styles/**"],
      "linter": {
        "rules": {
          "performance": { "noNamespaceImport": "off" },
          // `Box` and `Text` are prop-to-style dispatch tables: one `&&` per
          // supported prop, and the count only goes up as the system grows.
          // The branches are uniform and independent, so the score measures
          // how many props exist rather than how hard the function is to read.
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    }
  ]
}
